---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import openapi from '../../../generated/openapi.json';

/**
 * 交互式 API 参考文档：Scalar 基于 public/vendor/scalar 内置离线包运行，
 * 完全无需外部 CDN。本页在无 JavaScript 环境下亦可静态阅读。
 */
const spec = openapi.spec;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tags: Record<string, { path: string; method: string; operationId: string; summary: string }[]> = {};
for (const [path, methods] of Object.entries(spec.paths as Record<string, any>)) {
  for (const [method, op] of Object.entries(methods as Record<string, any>)) {
    const tag = op.tags?.[0] ?? 'Other';
    tags[tag] ??= [];
    tags[tag].push({ path, method, operationId: op.operationId, summary: op.summary });
  }
}
const configuration = {
  spec: { url: `${base}/api/downloads/openapi.json` },
  theme: { favicon: `${base}/favicon.svg` },
  hideDownloadButton: false,
  searchHotKey: '/',
};
---

<StarlightPage
  frontmatter={{
    title: '交互式 API 接口参考',
    description: 'StampDEX 公开接口交互式文档：包含所有公开端点、输入参数、响应格式与调用示例，由系统源码自动生成。',
  }}
>
  <p class="sd-api-lede">
    本参考手册直接提取自生产分支提交 <code>{openapi.provenance.sourceRef.slice(0, 7)}</code> 中的公开控制器。管理台及操作员私有接口已在架构上完全隔离。您可随时下载原始规范文件：{' '}
    <a href="/docs-stampdex/api/downloads/openapi.json">OpenAPI 3.1 JSON</a>。
  </p>

  <noscript>
    <p>
      交互式控制台需要 JavaScript 支持。在无脚本环境下，下方表格展示了全量接口清单，每个接口均可在导航栏 API 菜单中查看静态文档。
    </p>
  </noscript>

  {
    Object.entries(tags).map(([tag, operations]) => (
      <section class="sd-api-group">
        <h2>{tag}</h2>
        <div class="sd-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">请求方法</th>
                <th scope="col">接口路径</th>
                <th scope="col">功能说明</th>
              </tr>
            </thead>
            <tbody>
              {operations.map((op) => (
                <tr>
                  <td>
                    <span class="sd-api-method" data-method={op.method}>
                      {op.method.toUpperCase()}
                    </span>
                  </td>
                  <td><code>{op.path}</code></td>
                  <td>{op.summary}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }

  <div
    id="api-reference"
    data-configuration={JSON.stringify(configuration)}
  >
    <p class="sd-footnote">正在从本地离线资源库加载交互式控制台...</p>
  </div>
</StarlightPage>

<style>
  .sd-api-lede {
    font-size: 1rem;
    color: var(--sd-muted);
    max-width: 46rem;
    line-height: 1.65;
  }
  .sd-api-lede code,
  td code {
    font-family: var(--sd-mono);
    font-size: 0.82em;
    overflow-wrap: anywhere;
  }
  .sd-api-group {
    margin-top: 1.6rem;
  }
  .sd-api-group h2 {
    font-size: 1.2rem;
  }
</style>

<script is:inline src="/docs-stampdex/vendor/scalar/standalone.js" defer></script>
