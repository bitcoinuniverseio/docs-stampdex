---
/** The StampDEX product mark: a perforated Bitcoin postage stamp with its
 * teal protocol seal. Drawn inline so it stays crisp in the documentation
 * header and matches the application identity.
 */
interface Props {
  class?: string;
  size?: number;
}
const { class: className, size = 26 } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <rect x="0.75" y="0.75" width="62.5" height="62.5" rx="15" fill="#0a0a0a" stroke="#2a323e" stroke-width="1.5"></rect>
  <g transform="translate(32 34) rotate(-5)">
    <rect x="-23" y="-23" width="46" height="46" rx="3" fill="#e8a020" stroke="#b76e0a" stroke-width="1.4"></rect>
    <g fill="#0a0a0a">
      <circle cx="-20" cy="-23" r="2.2"></circle><circle cx="-10" cy="-23" r="2.2"></circle><circle cx="0" cy="-23" r="2.2"></circle><circle cx="10" cy="-23" r="2.2"></circle><circle cx="20" cy="-23" r="2.2"></circle>
      <circle cx="-20" cy="23" r="2.2"></circle><circle cx="-10" cy="23" r="2.2"></circle><circle cx="0" cy="23" r="2.2"></circle><circle cx="10" cy="23" r="2.2"></circle><circle cx="20" cy="23" r="2.2"></circle>
      <circle cx="-23" cy="-20" r="2.2"></circle><circle cx="-23" cy="-10" r="2.2"></circle><circle cx="-23" cy="0" r="2.2"></circle><circle cx="-23" cy="10" r="2.2"></circle><circle cx="-23" cy="20" r="2.2"></circle>
      <circle cx="23" cy="-20" r="2.2"></circle><circle cx="23" cy="-10" r="2.2"></circle><circle cx="23" cy="0" r="2.2"></circle><circle cx="23" cy="10" r="2.2"></circle><circle cx="23" cy="20" r="2.2"></circle>
    </g>
    <rect x="-18" y="-16" width="36" height="32" rx="2" fill="#d99a19"></rect>
    <g stroke="#0a0a0a" stroke-opacity="0.12" stroke-width="1">
      <line x1="-16" y1="-12" x2="16" y2="-12"></line><line x1="-16" y1="-6" x2="16" y2="-6"></line><line x1="-16" y1="0" x2="16" y2="0"></line><line x1="-16" y1="6" x2="16" y2="6"></line><line x1="-16" y1="12" x2="16" y2="12"></line>
    </g>
    <circle cx="0" cy="0" r="9" fill="#14b8a6" stroke="#0d7e75" stroke-width="1.2"></circle>
    <circle cx="0" cy="0" r="5.5" fill="#0d9488"></circle>
    <circle cx="0" cy="0" r="2" fill="#e8a020"></circle>
  </g>
</svg>
