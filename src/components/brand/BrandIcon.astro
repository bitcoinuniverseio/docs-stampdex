---
/** The StampDEX Docs mark: a perforated stamp plate with the rising ledger
 * bars. Drawn inline so it inherits size from CSS and stays crisp at 16px.
 * The shapes sit inside the rounded plate, so no clip path is needed.
 */
interface Props {
  class?: string;
  size?: number;
}
const { class: className, size = 26 } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="7" fill="#0b0e13" stroke="#2a323e" stroke-width="1"></rect>
  <g fill="#1c232e">
    <circle cx="4" cy="16" r="1.3"></circle><circle cx="28" cy="16" r="1.3"></circle>
    <circle cx="16" cy="4" r="1.3"></circle><circle cx="16" cy="28" r="1.3"></circle>
    <circle cx="7.5" cy="7.5" r="1.1"></circle><circle cx="24.5" cy="7.5" r="1.1"></circle>
    <circle cx="7.5" cy="24.5" r="1.1"></circle><circle cx="24.5" cy="24.5" r="1.1"></circle>
  </g>
  <rect x="7" y="19" width="5" height="7" rx="1" fill="#4fd6dd"></rect>
  <rect x="13.5" y="13" width="5" height="13" rx="1" fill="#a99bf5"></rect>
  <rect x="20" y="7" width="5" height="19" rx="1" fill="#f0aa4a"></rect>
</svg>
