---
import BrandIcon from './BrandIcon.astro';

/** Starlight SiteTitle override: the StampDEX wordmark and product mark. The
 * documentation label is intentionally secondary to the product identity.
 */
const route = Astro.locals.starlightRoute;
const { siteTitleHref } = route;
---

<a href={siteTitleHref} class="sd-brand" aria-label="StampDEX Docs home">
  <BrandIcon size={28} />
  <span class="sd-brand-name">
    <span>Stamp</span><span class="sd-brand-dex">DEX</span>
  </span>
  <span class="sd-brand-docs">Docs</span>
</a>

<style>
  .sd-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--sd-ink-inverse);
    white-space: nowrap;
    min-width: 0;
    padding: 0.25rem;
    margin: -0.25rem;
  }
  .sd-brand :global(svg) {
    flex: none;
    display: block;
  }
  .sd-brand-name {
    font-weight: 720;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--sd-ink-inverse);
  }
  .sd-brand-dex {
    color: var(--sd-brand-accent);
    margin-left: 0.02em;
  }
  .sd-brand-docs {
    color: var(--sd-muted-inverse);
    border-left: 1px solid var(--sd-rule-strong);
    font-size: 0.68rem;
    font-weight: 640;
    letter-spacing: 0.08em;
    margin-left: 0.15rem;
    padding-left: 0.55rem;
    text-transform: uppercase;
  }
  .sd-brand:hover .sd-brand-docs,
  .sd-brand:hover .sd-brand-dex {
    color: var(--sd-brand-accent);
  }
  .sd-brand:focus-visible {
    outline: 2px solid var(--sd-focus);
    outline-offset: 2px;
  }
  @media (max-width: 26rem) {
    .sd-brand-docs {
      display: none;
    }
  }
</style>
