---
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';
import { SECTION_LINKS, STAMPDEX_URL } from '../../data/site';

const { hasSidebar } = Astro.locals.starlightRoute;
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);

/**
 * Starlight PageFrame override.
 *
 * Article pages keep Starlight's exact sidebar mechanics, including the
 * accessible mobile menu button and its focus trap. Pages without a sidebar
 * (the homepage) get the same button and pane, filled with the site section
 * navigation, so every destination stays reachable on a phone. The pane is
 * Starlight's own `#starlight__sidebar`, so its aria wiring keeps working.
 */
---

<div class="page sl-flex">
  <header class="header"><slot name="header" /></header>
  {
    hasSidebar && (
      <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
        <MobileMenuToggle />
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
      </nav>
    )
  }
  {
    !hasSidebar && (
      <nav class="sidebar sd-splashnav print:hidden" aria-label="Documentation sections">
        <MobileMenuToggle />
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <ul class="sd-splashnav-list">
              {SECTION_LINKS.map((link) => (
                <li>
                  <a href={link.href} aria-current={isCurrent(link.href) ? 'true' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
            <a class="sd-splashnav-cta" href={STAMPDEX_URL} rel="noopener">
              Open StampDEX
            </a>
          </div>
        </div>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }

    /* Splash pages also host the menu button on narrow screens. */
    :global(:not([data-has-sidebar])) .header {
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sd-nav);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    :global([aria-expanded='true']) ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: '';
        padding-bottom: 1px;
      }
    }

    .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      padding-inline-start: var(--sl-content-inline-start);
    }

    @media (min-width: 50rem) {
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }
      :global(:not([data-has-sidebar])) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }
      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }
      /* The splash section menu is a narrow-screen affordance only; on
         desktop the header navigation carries the same links. */
      :global(:not([data-has-sidebar])) .sidebar-pane {
        --sl-sidebar-visibility: hidden;
        display: none;
      }
    }
  }
</style>

<style>
  .sd-splashnav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .sd-splashnav-list a {
    display: block;
    padding: 0.5rem 0.65rem;
    border-radius: var(--sd-r-sm);
    color: var(--sd-ink-inverse);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .sd-splashnav-list a:hover {
    background: rgba(226, 232, 241, 0.08);
  }

  .sd-splashnav-list a[aria-current='true'] {
    color: var(--sd-brand-accent);
    background: rgba(247, 147, 26, 0.12);
  }

  .sd-splashnav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--sd-brand);
    color: #07090d;
    font-size: 0.9rem;
    font-weight: 660;
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    border-radius: var(--sd-r-sm);
    align-self: flex-start;
  }
</style>
