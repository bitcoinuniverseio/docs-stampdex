---
import { SECTION_LINKS, STAMPDEX_URL } from '../../data/site';

/**
 * Starlight MobileMenuFooter override: the seven documentation sections and
 * the product link, at the end of the mobile page-tree menu, so a phone
 * reader reaches the same destinations the desktop header shows.
 */
---

<div class="sd-mobilemenu-links">
  <h2>Sections</h2>
  <ul>
    {
      SECTION_LINKS.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
    <li>
      <a href={STAMPDEX_URL} rel="noopener">Open StampDEX</a>
    </li>
  </ul>
</div>

<style>
  .sd-mobilemenu-links {
    border-top: 1px solid var(--sd-rule);
    margin-top: 0.9rem;
    padding-top: 0.7rem;
    padding-bottom: 1rem;
  }
  h2 {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sd-muted-inverse);
    margin: 0 0 0.4rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: block;
    padding: 0.34rem 0.2rem;
    color: var(--sd-ink-inverse);
    text-decoration: none;
    font-size: 0.88rem;
    border-radius: var(--sd-r-sm);
  }
  a:hover {
    background: rgba(226, 232, 241, 0.08);
  }
</style>
