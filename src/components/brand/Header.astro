---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import SiteTitle from 'virtual:starlight/components/SiteTitle';

import { SECTION_LINKS, STAMPDEX_URL, RELEASE } from '../../data/site';

/**
 * Starlight Header override.
 *
 * The desktop header puts the product and documentation paths first. Release
 * evidence, search, and display controls remain available without competing
 * with the primary navigation. Narrow screens drop the middle first: the
 * section menu button keeps every destination reachable.
 * Starlight's accessible built-ins (search dialog, theme pickers, focus
 * behaviour) are reused, not reimplemented.
 */
const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<div class="header sd-header">
  <div class="sd-header-primary">
    <div class="title-wrapper sl-flex">
      <SiteTitle />
    </div>

    <div class="sd-header-search sl-hidden md:sl-flex print:hidden">
      {shouldRenderSearch && <Search />}
    </div>

    <div class="sd-header-actions sl-flex print:hidden">
      <a class="sd-cta" href={STAMPDEX_URL} rel="noopener">
        Open StampDEX
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M14 3a1 1 0 0 0 0 2h3.6l-8.3 8.3a1 1 0 1 0 1.4 1.4L19 6.4V10a1 1 0 0 0 2 0V4a1 1 0 0 0-1-1h-6ZM5 5h4a1 1 0 0 1 0 2H6v11h11v-3a1 1 0 0 1 2 0v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"></path>
        </svg>
      </a>
      <div class="sd-header-tools">
        <div class="sl-flex social-icons">
          <SocialIcons />
        </div>
        <ThemeSelect />
        <LanguageSelect />
      </div>
    </div>
  </div>

  <div class="sd-header-sections">
    <nav class="sd-nav" aria-label="Documentation sections">
      {
        SECTION_LINKS.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'true' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      class="sd-release-chip"
      href={RELEASE.evidenceHref}
      title={`Documentation describes StampDEX release ${RELEASE.releaseId}. Open release evidence.`}
    >
      <span class="sd-release-dot" aria-hidden="true"></span>
      <span class="sd-release-label">Docs release</span>
      <span class="sd-release-value">{RELEASE.shortCommit}</span>
      <span class="sd-release-live" data-release-live hidden></span>
      <span class="sd-release-expected" hidden>docs: {RELEASE.shortCommit}</span>
    </a>
  </div>

<script>
  // Live API health: read-only, quick timeout, never blocks rendering,
  // shows Unknown on any failure, and sleeps while the tab is hidden.
  const el = document.querySelector("[data-release-live]");
  if (el) {
    const set = (t, cls) => { el.hidden = false; el.textContent = t; el.className = "sd-release-live " + cls; };
    const check = async () => {
      if (document.hidden) return;
      try {
        const res = await fetch("https://stamp.api.bitcoinuniverse.io/api/version", { signal: AbortSignal.timeout(4000) });
        if (!res.ok) throw new Error(res.status);
        const body = await res.json();
        const live = (body.gitCommit ?? "unknown").slice(0, 7);
        const expected = document.querySelector("[data-release-expected]")?.textContent.replace("docs:", "").trim();
        if (expected && live === expected) {
          set("Verified", "is-ok");
          el.title = "Production matches the commit this documentation describes";
        } else {
          set("Updated", "is-drift");
          el.title = "Production has moved past this documentation's commit. The pages describe " + (expected ?? "an earlier build") + ".";
        }
      } catch {
        el.hidden = true;
      }
    };
    check();
    document.addEventListener("visibilitychange", check);
  }
</script>
</div>

<style>
  @layer starlight.core {
    .header {
      background: var(--sd-nav);
      border-bottom: 1px solid rgba(185, 195, 208, 0.24);
      box-shadow: 0 8px 24px rgba(2, 6, 12, 0.14);
    }
    .sd-header {
      display: flex;
      flex-direction: column;
    }
    .sd-header-primary {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: 1rem;
      min-height: 3.75rem;
      min-width: 0;
    }
    .title-wrapper {
      min-width: 0;
    }
    .sd-header-search {
      flex: 1 1 20rem;
      max-width: 34rem;
      margin-inline: auto;
    }
    .sd-header-search :global(.sd-search-btn) {
      width: 100%;
    }
    .sd-header-actions {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      min-width: 0;
    }
    .sd-nav {
      display: flex;
      align-items: center;
      gap: 0.2rem;
      flex: 1;
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .sd-nav::-webkit-scrollbar {
      display: none;
    }
    .sd-nav a {
      display: inline-block;
      padding: 0.38rem 0.68rem;
      border: 1px solid transparent;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 620;
      color: var(--sd-muted-inverse);
      text-decoration: none;
      white-space: nowrap;
    }
    .sd-nav a:hover {
      color: var(--sd-ink-inverse);
      background: rgba(226, 232, 241, 0.08);
    }
    .sd-nav a[aria-current='true'] {
      color: var(--sd-ink-inverse);
      border-color: rgba(247, 147, 26, 0.58);
      background: rgba(247, 147, 26, 0.12);
    }
    .sd-release-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      min-height: 1.75rem;
      font-size: 0.68rem;
      color: var(--sd-muted-inverse);
      border-radius: 999px;
      padding: 0.1rem 0.55rem;
      background: rgba(255, 255, 255, 0.045);
      white-space: nowrap;
      text-decoration: none;
    }
    .sd-release-chip:hover {
      border-color: var(--sd-muted-inverse);
      color: var(--sd-ink-inverse);
    }
    .sd-release-dot {
      width: 0.42rem;
      height: 0.42rem;
      border-radius: 50%;
      background: var(--sd-brand);
      flex: none;
    }
    .sd-release-label {
      font-weight: 640;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      font-size: 0.58rem;
    }
    .sd-release-value {
      font-family: var(--sd-mono);
    }
    .sd-release-live {
      font-family: var(--sd-mono);
      margin-left: 0.25rem;
      padding-left: 0.4rem;
      border-left: 1px solid rgba(185, 195, 208, 0.42);
    }
    .sd-release-live.is-ok {
      color: #6fcb80;
    }
    .sd-release-live.is-drift {
      color: var(--sd-brand-accent);
    }
    .sd-release-expected[hidden] {
      display: none;
    }
    .sd-release-expected {
      display: none;
    }
    .sd-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--sd-brand);
      color: #07090d;
      min-height: 2.1rem;
      font-size: 0.78rem;
      font-weight: 720;
      text-decoration: none;
      padding: 0.4rem 0.7rem;
      border-radius: var(--sd-r-md);
      box-shadow: 0 2px 8px rgba(247, 147, 26, 0.2);
      white-space: nowrap;
    }
    .sd-cta:hover {
      background: var(--sd-brand-accent);
      box-shadow: 0 3px 12px rgba(247, 147, 26, 0.32);
    }
    .sd-header-search :global(.sd-search-btn) {
      min-height: 2.25rem;
      border-color: rgba(185, 195, 208, 0.5);
      border-radius: var(--sd-r-md);
      background: rgba(255, 255, 255, 0.06);
      color: var(--sd-ink-inverse);
    }
    .sd-header-search :global(.sd-search-btn:hover) {
      border-color: var(--sd-brand-accent);
      background: rgba(255, 255, 255, 0.1);
      color: var(--sd-ink-inverse);
    }
    .sd-header-search :global(.sd-search-btn kbd) {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(185, 195, 208, 0.38);
      color: var(--sd-muted-inverse);
    }
    .sd-header-tools {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      color: var(--sd-muted-inverse);
    }
    .sd-header-sections {
      display: none;
      align-items: center;
      gap: 1rem;
      min-height: 2.25rem;
      border-top: 1px solid rgba(185, 195, 208, 0.16);
    }
    @media (min-width: 70rem) {
      .sd-header-sections {
        display: flex;
      }
      .sd-header-primary {
        min-height: 3.6rem;
      }
      .sd-header-search {
        display: flex;
      }
    }
    @media (max-width: 69.999rem) {
      .sd-header-search,
      .sd-cta {
        display: none;
      }
    }
    :focus-visible {
      outline: 2px solid var(--sd-focus);
      outline-offset: 2px;
    }
  }
</style>
