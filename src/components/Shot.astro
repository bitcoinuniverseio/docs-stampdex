---
/**
 * A real screenshot captured from the production site on 2026-08-28. Nothing
 * here is a mockup. Where no real capture exists, this site draws a diagram
 * and says so instead.
 */
interface Props {
  src: string;
  width: number;
  height: number;
  alt: string;
  caption: string;
}
const { src, width, height, alt, caption } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class="sd-shot">
  <img
    src={`${base}/screens/${src}`}
    width={width}
    height={height}
    alt={alt}
    loading="lazy"
    decoding="async"
  />
  <figcaption>
    {caption} <span class="sd-shot-meta">Captured from production, 2026-08-28.</span>
  </figcaption>
</figure>

<style>
  .sd-shot {
    margin: 1.6rem 0;
    border: 1px solid var(--sd-rule);
    border-radius: 4px;
    overflow: hidden;
    background: var(--sd-panel);
  }
  .sd-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--sd-rule);
  }
  .sd-shot figcaption {
    background: var(--sd-panel-2);
    padding: 0.5rem 0.8rem;
    font-size: 0.82rem;
    color: var(--sd-muted);
    line-height: 1.55;
  }
  .sd-shot-meta {
    display: block;
    font-size: 0.74rem;
    opacity: 0.85;
    margin-top: 0.15rem;
  }
</style>
