---
// Starlight pins the hero heading id to this value (constants.ts, not exported
// publicly). Keeping it in one local constant keeps the skip link working.
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const external = (link: string) => link.startsWith('http');
---

<div class="sd-hero">
  <p class="sd-hero-kicker">StampDEX documentation</p>
  <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
  {tagline && <p class="sd-hero-copy" set:html={tagline} />}
  {
    actions.length > 0 && (
      <div class="sd-hero-actions">
        {actions.map(({ attrs: { class: className, ...attrs } = {}, link, text, variant }) => (
          <a
            href={link}
            class:list={[
              'sd-btn',
              variant === 'minimal'
                ? 'sd-btn-quiet'
                : variant === 'secondary'
                  ? 'sd-btn-secondary'
                  : 'sd-btn-primary',
              className,
            ]}
            rel={external(link) ? 'noopener' : undefined}
            {...attrs}
          >
            {text}
            {external(link) && (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M14 3a1 1 0 0 0 0 2h3.6l-8.3 8.3a1 1 0 1 0 1.4 1.4L19 6.4V10a1 1 0 0 0 2 0V4a1 1 0 0 0-1-1h-6ZM5 5h4a1 1 0 0 1 0 2H6v11h11v-3a1 1 0 0 1 2 0v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" />
              </svg>
            )}
          </a>
        ))}
      </div>
    )
  }
  <span class="sd-perf" aria-hidden="true"></span>
</div>

<style>
  .sd-hero {
    margin: 0 0 2.2rem;
    padding: 2.2rem 1.5rem 1.9rem;
    border: 1px solid var(--sd-rule);
    border-radius: var(--sd-r-lg);
    background:
      radial-gradient(
        130% 100% at 88% -20%,
        rgba(247, 147, 26, 0.17),
        transparent 56%
      ),
      var(--sd-bg-deep);
    color: var(--sd-ink-inverse);
    box-shadow: var(--sd-shadow-2);
  }
  h1 {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.6rem);
    font-weight: 740;
    letter-spacing: -0.022em;
    line-height: 1.12;
    margin: 0 0 0.6rem;
    color: var(--sd-ink-inverse);
    text-wrap: balance;
  }
  .sd-hero-kicker {
    font-family: var(--sd-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--sd-brand-accent);
    margin: 0 0 0.7rem;
    font-weight: 700;
  }
  .sd-hero-copy {
    font-size: 1.04rem;
    line-height: 1.66;
    max-width: 44rem;
    color: var(--sd-muted-inverse);
    margin: 0;
  }
  .sd-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.2rem;
  }
  .sd-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.92rem;
    font-weight: 660;
    text-decoration: none;
    padding: 0.55rem 1rem;
    border-radius: var(--sd-r-sm);
    border: 1px solid transparent;
  }
  .sd-btn:focus-visible {
    outline: 2px solid var(--sd-brand-accent);
    outline-offset: 2px;
  }
  .sd-btn-primary {
    background: var(--sd-brand);
    color: #07090d;
  }
  .sd-btn-primary:hover {
    filter: brightness(1.08);
  }
  .sd-btn-secondary {
    border-color: var(--sd-rule-strong);
    color: var(--sd-ink-inverse);
  }
  .sd-btn-secondary:hover {
    border-color: var(--sd-muted-inverse);
  }
  .sd-btn-quiet {
    color: var(--sd-muted-inverse);
    padding-inline: 0.5rem;
  }
  .sd-btn-quiet:hover {
    color: var(--sd-brand-accent);
  }
  .sd-perf {
    display: block;
    width: 100%;
    height: 6px;
    margin-top: 1.7rem;
    background-image: radial-gradient(
      circle at 6px 3px,
      rgba(247, 147, 26, 0.55) 2.2px,
      transparent 2.6px
    );
    background-size: 14px 6px;
    background-repeat: repeat-x;
  }
</style>
